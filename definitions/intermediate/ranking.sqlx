config {
  type: "table",
  database: dataform.projectConfig.defaultDatabase,
  schema: dataform.projectConfig.schemaSuffix,
  name: "ranked",
}

SELECT DISTINCT tb1.cliente_1, tb1.cliente_2, tb1.score, tb1.match_type
FROM ${ref("match-tiebreak")} AS tb1
INNER JOIN (
  SELECT cliente_1, cliente_2, MAX(score) AS max_score
  FROM ${ref("match-tiebreak")}
  GROUP BY cliente_1, cliente_2
) AS tb2
ON tb1.cliente_1 = tb2.cliente_1
AND tb1.cliente_2 = tb2.cliente_2
AND tb1.score = tb2.max_score