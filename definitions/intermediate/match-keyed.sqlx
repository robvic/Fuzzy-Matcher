config {
  type: "table",
  database: dataform.projectConfig.defaultDatabase,
  schema: dataform.projectConfig.schemaSuffix,
  name: "match-keyed",
}

WITH input_keyed AS (
  SELECT 
    tb1.*, 
    REGEXP_REPLACE(tb2.cnpj, r"[-.]", "") AS cnpj
  FROM ${ref("preprocessed")} AS tb1
  LEFT JOIN main.load AS tb2
),
origem_1 AS (
  SELECT *
  FROM input_keyed
  WHERE origem = "${constants.origem_1}"
),
origem_2 AS (
  SELECT *
  FROM input_keyed
  WHERE origem = "${constants.origem_2}"
)
SELECT
  tb1.id AS id_1,
  tb2.id AS id_2,
  tb1.cliente AS cliente_1,
  tb2.cliente AS cliente_2,
  1.0 AS score, 
  "keyed" AS match_type
FROM origem_1 AS tb1
INNER JOIN origem_2 AS tb2
ON tb1.cnpj = tb2.cnpj